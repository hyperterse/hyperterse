{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/hyperterse/hyperterse/refs/heads/main/schema/root.terse.schema.json",
  "title": "HyperterseRootConfig",
  "description": "Schema for root project configuration files (`.hyperterse`) that define project-level settings.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name.",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "description": "Optional project version for observability metadata.",
      "minLength": 1
    },
    "root": {
      "type": "string",
      "description": "Base directory for discovery (defaults to `app`).",
      "minLength": 1
    },
    "build": {
      "type": "object",
      "description": "Optional build configuration.",
      "properties": {
        "out": {
          "type": "string",
          "description": "Build output directory.",
          "minLength": 1
        },
        "out_dir": {
          "type": "string",
          "description": "Alias for build.out.",
          "minLength": 1
        },
        "clean_dir": {
          "type": "boolean",
          "description": "Clean output directory before build."
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "description": "Tool discovery and global tool cache/search settings.",
      "properties": {
        "directory": {
          "type": "string",
          "description": "Tools directory relative to `root` (defaults to `tools`).",
          "minLength": 1
        },
        "search": {
          "type": "object",
          "description": "Global/default MCP tool search configuration.",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum number of MCP search results returned (default: 10)."
            }
          },
          "additionalProperties": false
        },
        "cache": {
          "type": "object",
          "description": "Global/default tool cache configuration.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "ttl": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "adapters": {
      "type": "object",
      "description": "Adapter discovery settings.",
      "properties": {
        "directory": {
          "type": "string",
          "description": "Adapters directory relative to `root` (defaults to `adapters`).",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "description": "Agent discovery and default tool access settings.",
      "properties": {
        "directory": {
          "type": "string",
          "description": "Agents directory relative to `root` (defaults to `agents`).",
          "minLength": 1
        },
        "tool_access": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "allow_all",
                "allow_none",
                "allow_list"
              ]
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "mode"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "allow_list"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "tools"
                ]
              }
            }
          ],
          "additionalProperties": false,
          "description": "Default tool access policy for agents discovered from this project."
        }
      },
      "additionalProperties": false
    },
    "prompts": {
      "description": "Prompt discovery settings (`prompts.directory`) or optional inline prompt definitions.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "directory": {
              "type": "string",
              "description": "Prompts directory relative to `root` (defaults to `prompts`).",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "description": "Prompt discovery settings."
        },
        {
          "type": "array",
          "description": "Optional inline prompt definitions.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$",
                "minLength": 1,
                "description": "Prompt name."
              },
              "title": {
                "type": "string",
                "description": "Optional prompt title."
              },
              "description": {
                "type": "string",
                "description": "Optional prompt description."
              },
              "arguments": {
                "type": "array",
                "description": "Prompt arguments.",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
                      "minLength": 1,
                      "description": "Argument name."
                    },
                    "title": {
                      "type": "string",
                      "description": "Optional human-friendly title."
                    },
                    "description": {
                      "type": "string",
                      "description": "Optional argument description."
                    },
                    "required": {
                      "type": "boolean",
                      "description": "Whether this argument is required."
                    },
                    "completion": {
                      "type": "array",
                      "description": "Optional static completion values.",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              },
              "messages": {
                "type": "array",
                "description": "Prompt messages.",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string",
                      "enum": [
                        "user",
                        "assistant",
                        "system"
                      ],
                      "description": "MCP prompt message role."
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Prompt message content."
                    }
                  },
                  "required": [
                    "role",
                    "text"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "messages"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "resources": {
      "description": "Resource discovery settings (`resources.directory`) or optional inline concrete resources.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "directory": {
              "type": "string",
              "description": "Resources directory relative to `root` (defaults to `resources`).",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "description": "Resource discovery settings."
        },
        {
          "type": "array",
          "description": "Optional inline concrete resources.",
          "items": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1,
                "description": "Resource URI."
              },
              "name": {
                "type": "string",
                "description": "Optional resource name."
              },
              "title": {
                "type": "string",
                "description": "Optional resource title."
              },
              "description": {
                "type": "string",
                "description": "Optional resource description."
              },
              "mime_type": {
                "type": "string",
                "description": "Optional MIME type."
              },
              "text": {
                "type": "string",
                "description": "Inline text content."
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "description": "File path for resource content."
              }
            },
            "required": [
              "uri"
            ],
            "allOf": [
              {
                "oneOf": [
                  {
                    "required": [
                      "text"
                    ]
                  },
                  {
                    "required": [
                      "file"
                    ]
                  }
                ]
              }
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "resource_templates": {
      "type": "array",
      "description": "Optional inline resource template definitions.",
      "items": {
        "type": "object",
        "properties": {
          "uri_template": {
            "type": "string",
            "minLength": 1,
            "description": "URI template (RFC 6570)."
          },
          "name": {
            "type": "string",
            "description": "Optional template name."
          },
          "title": {
            "type": "string",
            "description": "Optional template title."
          },
          "description": {
            "type": "string",
            "description": "Optional template description."
          },
          "mime_type": {
            "type": "string",
            "description": "Optional MIME type."
          },
          "text_template": {
            "type": "string",
            "description": "Inline text template content."
          },
          "file_template": {
            "type": "string",
            "minLength": 1,
            "description": "File path template for resource content."
          },
          "arguments": {
            "type": "array",
            "description": "Template arguments.",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
                  "minLength": 1,
                  "description": "Template argument name."
                },
                "title": {
                  "type": "string",
                  "description": "Optional human-friendly title."
                },
                "description": {
                  "type": "string",
                  "description": "Optional argument description."
                },
                "required": {
                  "type": "boolean",
                  "description": "Whether this argument is required."
                },
                "completion": {
                  "type": "array",
                  "description": "Optional static completion values.",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "uri_template"
        ],
        "allOf": [
          {
            "oneOf": [
              {
                "required": [
                  "text_template"
                ]
              },
              {
                "required": [
                  "file_template"
                ]
              }
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    "server": {
      "type": "object",
      "description": "Runtime server configuration.",
      "properties": {
        "port": {
          "description": "Server port (default: 8080).",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "string",
              "pattern": "^[0-9]{1,5}$"
            }
          ]
        },
        "log_level": {
          "type": "integer",
          "description": "Log level: 1=ERROR, 2=WARN, 3=INFO, 4=DEBUG.",
          "minimum": 1,
          "maximum": 4
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}